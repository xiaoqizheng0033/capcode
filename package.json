{
  "name": "repo-manager",
  "version": "1.1.0",
  "description": "Local Git repository manager with web UI",
  "private": true,
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npx vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npx vite build",
    "start": "node server/index.js",
    "service:install": "node server/install-service.js install",
    "service:uninstall": "node server/install-service.js uninstall"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "node-windows": "^1.0.0-beta.8",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
