{
  "name": "repo-manager",
  "version": "1.0.0",
  "description": "Local Git repository manager with web UI",
  "private": true,
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npx vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npx vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
